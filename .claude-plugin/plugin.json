{
  "name": "hallucinote",
  "displayName": "Hallucinote \u2014 Music Authoring",
  "version": "0.9.3",
  "description": "DB-backed MIDI authoring with Ableton Live sync via MCP. Compose, arrange, sound-design, and mix songs with Claude \u2014 live audio feedback, structured so the model sees musical structure, not pixels.",
  "author": {
    "name": "Brooks Talley",
    "email": "brooks@tangentry.com"
  },
  "homepage": "https://github.com/brookstalley/hallucinote#readme",
  "repository": "https://github.com/brookstalley/hallucinote",
  "license": "MIT",
  "keywords": [
    "music",
    "composition",
    "ableton",
    "midi",
    "audio",
    "mcp",
    "generative"
  ],
  "defaultEnabled": true,
  "mcpServers": {
    "hallucinote-mcp": {
      "command": "uv",
      "args": [
        "run", "--frozen", "--all-packages",
        "--project", "${CLAUDE_PLUGIN_ROOT}",
        "hallucinote-mcp", "serve"
      ],
      "env": { "UV_PROJECT_ENVIRONMENT": "${CLAUDE_PLUGIN_DATA}/venv" },
      "timeout": 60000
    }
  }
}

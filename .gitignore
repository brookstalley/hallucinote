__pycache__/
*.pyc
.DS_Store
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Hallucinote DB files (per-user, never committed)
*.db
*.db-journal
*.db-wal
*.db-shm

# Claude Code MCP server config — per-user / per-environment. The install
# skill writes the correct shape for the user's environment (bare-name vs
# absolute venv path). See .mcp.json.example for the canonical entry.
.mcp.json

# Build artifacts
build/
dist/

# NOTE: uv.lock IS tracked (INS-7V2D). The plugin bundles the MCP server and runs
# it with uv from this committed lock into a ${CLAUDE_PLUGIN_DATA} env, so the lock
# IS the version-coupling guarantee — it must ship with the plugin. Do not ignore it.
# (The editable dev install via `pip install -e` doesn't read it; both coexist.)

# Ableton Live project directories — local DAW state, not source of truth.
# Captured snapshots ARE source of truth (build.py replays them) and are
# tracked explicitly per song at songs/<name>/captured_session.json.
**/*.als
**/*.flac
**/* Project/

# W12-B `/song-snapshot` side-by-side: skill writes this, mv/rm's on user
# decision. Crashed/aborted flow can leave it behind — keep it untrackable.
**/captured_session.refresh.json

# Prawduct session files
.claude/settings.local.json
.claude/worktrees/
.prawduct/.critic-findings.json
.prawduct/.test-evidence.json
.prawduct/.pr-reviews/
.prawduct/.handoff-notes.md
.prawduct/.session-git-baseline
.prawduct/.session-handoff.md
.prawduct/.session-reflected
.prawduct/.session-start
.prawduct/.subagent-briefing.md
.prawduct/.gates-waived
.prawduct/.governance-ledger.jsonl
.prawduct/.work-model-index.json
.prawduct/.bug-inbox
.prawduct/.sync-pending
.prawduct/reflections.md
.prawduct/reflections-archive-*.md
.prawduct/sync-manifest.json
.claude/scheduled_tasks.lock

# E2E push-test ephemera (Wave 3 throwaway artifacts until ableton-push skill ships)
.prawduct/.push-clip-*.json
.prawduct/.push-plan-*.json
.prawduct/.push-results-*.json
.prawduct/.push-session-id
.prawduct/.push-findings.md
.prawduct/.getting-started-prompts.md
.prawduct/push-orchestrator.py
.getting-started-prompts.md

# Per-machine push state (carries this machine's session/song UUIDs + timestamps)
songs/*/.last-push-state.json
songs/*/.last-push-errors.json

# Audio-analysis MVP (Chunk 2) — heavy per-render WAVs + manifest live in
# captures/ next to each song; the small MixReport JSONs in analysis/ ARE
# checked in. `.hallucinote/stems/` is reserved for the post-MVP
# "always-on" stem cache. `*.amxd~` is Max's autosave backup produced
# when editing the device in the GUI; never source-of-truth.
songs/*/captures/
.hallucinote/stems/
*.amxd~

# Scenario-eval results (tests/scenarios/results/): ad-hoc timestamped runs are
# ephemeral, LLM-simulated + non-deterministic working material — accumulating
# them in git is churn, not signal. Only the pinned latest-passing
# `canonical-<brief>.json` (+ its `canonical-<brief>.transcript.md`, when saved)
# is tracked, as the durable verification evidence for this behaviorally-judged,
# non-unit-testable work. See tests/scenarios/results/README.md.
tests/scenarios/results/*
!tests/scenarios/results/.gitkeep
!tests/scenarios/results/README.md
!tests/scenarios/results/canonical-*

# Prawduct session files
.prawduct/.advisories.json

# Prawduct plugin version marker (per-repo last-seen)
.prawduct/.prawduct-version

# Prawduct session files
.prawduct/.critic-active
.prawduct/.critic-partials/
.prawduct/.session-base-tree

# Incoming bug-report drop-zone, including archives/ — local working notes, never
# published (owner decision 2026-08-06, at the point the repo went public). Raw
# triage reports enter the public record as BACKLOG ITEMS via /prawduct:backlog,
# and the backlog id is their citable provenance; see project-preferences.md
# "Incoming-bugs triage". Nothing tracked may cite a path in here — it would
# dangle for every reader without the local file.
incoming-bugs/

# Prawduct session files
.prawduct/.critic-partials-archive/
.prawduct/.handoff-notes.md

# The example workspace generates the same per-song build artifacts as songs/,
# so it needs the same exclusions — otherwise a demo push commits its rendered
# takes and push state. Kept adjacent to the songs/* rules above, which these
# mirror line for line.
examples/*/.last-push-state.json
examples/*/.last-push-errors.json
examples/*/captures/

# Tour capture working directory — shoot liberally here, commit selectively.
# The committed evidence lives in docs/assets/ under a hard byte budget.
examples/*/_capture/
